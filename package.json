  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/anton": "5.2.7",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/inter": "5.1.0",
    "@fontsource/special-elite": "5.1.0",
    "@fontsource/vt323": "5.3.0",
    "peerjs": "1.5.5",
    "three": "0.170.0"
  }
}
